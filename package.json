{
  "name": "dsh-quota",
  "version": "0.14.11",
  "icon": "./icon.svg",
  "description": "DeepSeek Harness plugin: multi-platform plan quota, API balance, burn-rate pacing radar, composer dock bar, and adaptive session/daily spend ledger via DSH credentials and MCP.",
  "license": "MIT",
  "author": "Minokun",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Minokun/dsh-quota.git"
  },
  "homepage": "https://github.com/Minokun/dsh-quota#readme",
  "bugs": "https://github.com/Minokun/dsh-quota/issues",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": true
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "README.en.md",
    "docs/extending.md"
  ],
  "scripts": {
    "build": "tsdown && node scripts/check-client-id.mjs",
    "prepare": "tsdown",
    "dev": "tsdown --watch",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "link-harness": "sh scripts/link-harness.sh"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "0.22.2",
    "typescript": "6.0.3",
    "unrun": "^0.3.1"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "quota",
    "usage",
    "billing",
    "cost",
    "coding-plan",
    "kimi",
    "deepseek",
    "bigmodel",
    "zhipu",
    "openrouter",
    "claude",
    "codex",
    "magpie",
    "token-monitor"
  ],
  "packageManager": "pnpm@11.7.0+sha512.19cc852c120c7125760f2443ee6be0ca5b40f9f50598de1a09a1f177503e010e57c23c77646e01e761de59bf874fb22a3398c33ab9691fc13eb946b6f0f4d620"
}
